        <mxPoint x="390" y="3590" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="v8" value="Driver Service&amp;#xa;驱动服务 A/B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="592" y="140" width="156" height="54" as="geometry" />
