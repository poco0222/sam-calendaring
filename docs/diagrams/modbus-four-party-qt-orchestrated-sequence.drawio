  <diagram name="QT主编排四方交互时序图">
    <mxGraphModel dx="1800" dy="3730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1410" pageHeight="3730" math="0" shadow="0">
