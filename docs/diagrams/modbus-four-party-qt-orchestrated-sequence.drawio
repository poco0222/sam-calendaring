      <mxGeometry x="312" y="140" width="156" height="54" as="geometry" />
    </mxCell>
    <mxCell id="l7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#777777;strokeWidth=1;dashed=1;dashPattern=2 6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
