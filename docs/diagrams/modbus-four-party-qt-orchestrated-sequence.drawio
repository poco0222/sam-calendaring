        <mxPoint x="670" y="3590" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="v10" value="Driver Local State&amp;#xa;本地租约/审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="872" y="140" width="156" height="54" as="geometry" />
    </mxCell>
    <mxCell id="l11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#777777;strokeWidth=1;dashed=1;dashPattern=2 6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="950" y="194" as="sourcePoint" />
        <mxPoint x="950" y="3590" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="v12" value="Modbus Device&amp;#xa;压机设备 A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1152" y="140" width="156" height="54" as="geometry" />
    </mxCell>
    <mxCell id="l13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#777777;strokeWidth=1;dashed=1;dashPattern=2 6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1230" y="194" as="sourcePoint" />
        <mxPoint x="1230" y="3590" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="v14" value="1. 获取授权：ERP 签发 lease，QT 只传递，不自行决定跨设备权限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d9d9d9;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1">
      <mxGeometry x="45" y="225" width="1320" height="455" as="geometry" />
    </mxCell>
    <mxCell id="v15" value="2. 连接设备：Driver 离线验签 lease + signal config 后才允许连接" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d9d9;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1">
      <mxGeometry x="45" y="705" width="1320" height="575" as="geometry" />
    </mxCell>
    <mxCell id="v16" value="3. 临时接管：B 工控机接管 A 压机需要 takeover lease 和 fencingToken" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d9d9d9;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1">
      <mxGeometry x="45" y="1305" width="1320" height="520" as="geometry" />
    </mxCell>
    <mxCell id="v17" value="4. 锁模与开始加工：QT 编排业务，Driver 只执行设备动作" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d9d9;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1">
      <mxGeometry x="45" y="1850" width="1320" height="670" as="geometry" />
    </mxCell>
    <mxCell id="v18" value="5. 加工中监听与参数快照：Driver 返回快照，QT 写 ERP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d9d9d9;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1">
      <mxGeometry x="45" y="2545" width="1320" height="360" as="geometry" />
    </mxCell>
    <mxCell id="v19" value="6. 结束加工：QT 先完成 ERP 业务，再命令 Driver 设备收尾" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d9d9;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1">
      <mxGeometry x="45" y="2930" width="1320" height="610" as="geometry" />
    </mxCell>
