    <mxCell id="e46" value="启动/登录：operatorId + granteeHostId + stationId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="130" y="270" as="sourcePoint" />
        <mxPoint x="390" y="270" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="e47" value="返回当前工控机默认设备范围&amp;#xa;和业务上下文" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;dashPattern=8 6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="390" y="315" as="sourcePoint" />
        <mxPoint x="130" y="315" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="e48" value="请求设备 A 的 device connection info&amp;#xa;signal config + signed connection lease" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="130" y="365" as="sourcePoint" />
        <mxPoint x="390" y="365" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="v49" value="ERP policy engine（策略引擎）决策：&amp;#xa;- 人员 role / 班组 / 工位&amp;#xa;- granteeHostId 是否允许&amp;#xa;- targetDeviceId 当前状态&amp;#xa;- jobId / stationId 上下文&amp;#xa;- normal 或 takeover mode&amp;#xa;- 审计申请原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="420" y="400" width="285" height="155" as="geometry" />
    </mxCell>
    <mxCell id="v50" value="lease claims（租约声明）：&amp;#xa;leaseId, targetDeviceId, targetEndpoint, granteeHostId, operatorId, stationId, jobId, signalConfigHash, allowedScopes, allowedAddressRanges, issuedAt, notBefore, expiresAt, fencingToken, takeoverFlag, takeoverReason, signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="720" y="380" width="445" height="175" as="geometry" />
    </mxCell>
    <mxCell id="e51" value="返回整体授权包：device config + signal config&amp;#xa;+ signed lease（连接参数受签名保护）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;dashPattern=8 6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="390" y="630" as="sourcePoint" />
        <mxPoint x="130" y="630" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="e52" value="applyLeaseAndConfig(signedLease, signalConfig)&amp;#xa;不允许单独覆盖 ip/port/deviceId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="130" y="750" as="sourcePoint" />
        <mxPoint x="670" y="750" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="e53" value="写入 pending lease，检查重放" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="670" y="805" as="sourcePoint" />
        <mxPoint x="950" y="805" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="e54" value="本地返回 seen fencingToken / leaseId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;dashPattern=8 6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="950" y="845" as="sourcePoint" />
        <mxPoint x="670" y="845" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="v55" value="Driver offline verification（离线验签）：&amp;#xa;1. signature 使用 ERP public key 验证&amp;#xa;2. granteeHostId == 本机硬件/安装身份&amp;#xa;3. targetDeviceId / endpoint 只能来自 lease&amp;#xa;4. signalConfigHash 匹配&amp;#xa;5. command 落在 allowedScopes / allowedAddressRanges&amp;#xa;6. expiresAt 未过期&amp;#xa;7. fencingToken &gt;= 本地已见 token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="690" y="875" width="330" height="190" as="geometry" />
    </mxCell>
    <mxCell id="e56" value="拒绝连接：签名无效/过期/工控机不匹配/配置被替换/地址越权" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;dashPattern=8 6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="670" y="1090" as="sourcePoint" />
        <mxPoint x="130" y="1090" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="e57" value="验签通过：connect targetEndpoint&amp;#xa;并读取 device identity register / signal fingerprint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="670" y="1145" as="sourcePoint" />
        <mxPoint x="1230" y="1145" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="e58" value="返回设备身份/指纹 + 初始信号" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;dashPattern=8 6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1230" y="1190" as="sourcePoint" />
        <mxPoint x="670" y="1190" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="e59" value="保存 active lease + audit log&amp;#xa;若身份不匹配则断开并拒绝" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="670" y="1230" as="sourcePoint" />
        <mxPoint x="950" y="1230" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="e60" value="返回 connected + signal snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;dashPattern=8 6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="670" y="1260" as="sourcePoint" />
        <mxPoint x="130" y="1260" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="e61" value="A 故障：请求 B 临时接管 A&amp;#xa;targetDeviceId=A + reason + approver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1">
