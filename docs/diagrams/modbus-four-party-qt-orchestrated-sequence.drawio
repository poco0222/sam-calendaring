    <mxCell id="v2" value="四方交互目标态时序图：QT 主编排 + Driver 离线验签设备网关" style="text;html=1;strokeColor=none;fillColor=none;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="190" y="10" width="1030" height="38" as="geometry" />
    </mxCell>
    <mxCell id="v3" value="设计原则：QT App 从 ERP 获取业务数据、设备连接信息、signal config（信号配置）和 signed connection lease（签名连接授权租约）；Driver Service 不直接访问 ERP，只离线验签授权包并操作 Modbus TCP 设备。&amp;#xa;作者：PopoY；创建日期：2026-06-22" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="45" y="55" width="1320" height="62" as="geometry" />
    </mxCell>
    <mxCell id="v4" value="QT App A/B&amp;#xa;人机交互应用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="52" y="140" width="156" height="54" as="geometry" />
    </mxCell>
    <mxCell id="l5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#777777;strokeWidth=1;dashed=1;dashPattern=2 6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
